# Ordering Sensitive Assignments
# ==============================
set_instance_assignment -name PARTITION_COLOUR 4294936451 -to top -entity top
set_instance_assignment -name PARTITION_COLOUR 4288020447 -to auto_fab_0 -entity top
set_global_assignment -name PROJECT_IP_REGENERATION_POLICY NEVER_REGENERATE_IP
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name BOARD default
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL

# SDC and TCL file Assignments
# ==============================
set_global_assignment -name SDC_FILE hssi_ss_constraints.sdc
set_global_assignment -name SDC_FILE ptp_bridge_ip.sdc
set_global_assignment -name SDC_FILE ftile_ptp_ed.sdc
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE rtl_list.tcl
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE ip_list.tcl

