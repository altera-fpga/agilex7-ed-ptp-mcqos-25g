 }
 #endif
 
+#if defined(CONFIG_FPGA_ALTERA)
+
+#define FIT_IMAGE_HEADER_ADDR 0x02000000
+#define FIT_IMAGE_FDT_NODE_PATH "/images/fdt-0"
+#define FDT_HSSISS_NODE_PATH "/soc/hssi_0_eth/fixed-link"
+#define PTP_SYS_ED_10G 10000
+#define PTP_SYS_ED_25G 25000
+
+/*function to read out ethernet speed from linux dts*/
+static u32 get_ptp_design_info(void)
+{
+	void *ptr;
+	int nodeoffset = 0;
+	int images_noffset;
+	u32 data;
+	size_t size;
+	void *hdr = (char *)FIT_IMAGE_HEADER_ADDR;
+	u32 design_info = 0;
+
+	images_noffset = fdt_path_offset(hdr, FIT_IMAGE_FDT_NODE_PATH);
+	fit_image_get_data_and_size(hdr, images_noffset, &data, &size);
+	if (data == 0)
+		goto design_info_result;
+
+	/*printf("FDT start addr from FIT image is %x", data);*/
+	/*pointer pointing to FDT structure*/
+	ptr = (char *)data;
+	set_working_fdt_addr((ulong)ptr);
+	nodeoffset = fdt_path_offset(working_fdt, FDT_HSSISS_NODE_PATH);
+	fdt32_t *nodep = (fdt32_t *)fdt_getprop(working_fdt, nodeoffset, "speed", 0);
+
+	if (!nodep)
+		goto design_info_result;
+
+	/*return u32 value after endianness change*/
+	design_info =  fdt32_to_cpu(*(nodep));
+design_info_result:
+	return design_info;
+}
+
+// Intel Agilex FM87 board support for 1588/PTP
+// write ZL30733 registers via I2C
+#define ZL30733_ID_VALUE 0x0e95 // ZL30733
+static void zl30733_i2c_init(u32 design_info)
+{
+	struct udevice *udev = NULL;
+	u8 page = 0, new_page, id[2] = {0, 0}, addr;
+	int ret_val, i, val;
+	const struct mfg_i2c_cmd *ptr_cmd_tbl;
+	int  total_cmd_list = 0;
+
+	printf(" Initializing Clock Cleaner (ZL30733) via I2C ");
+	ret_val = i2c_get_chip_for_busnum(0, 0x70, 1, &udev);
+	if (ret_val || !udev) {
+		printf("\n%s: Could not identify ZL30733 chip on I2C bus 0, "
+		       "address 0x70\n", __func__);
+		return;
+	}
+	// select page 0:
+	ret_val = dm_i2c_write(udev, 0x7f, &page, 1);
+	if (ret_val) {
+		printf("\n%s: ZL30733 I2C write bus 0, chip addr 0x70, "
+		       "offset 0x7f failed\n", __func__);
+		return;
+	}
+	// read ID register:
+	ret_val = dm_i2c_read(udev, 1, id, 2);
+	if (ret_val) {
+		printf("\n%s: ZL30733 I2C read bus 0, chip addr 0x70, "
+		       "offset 1 failed\n", __func__);
+		return;
+	}
+	if (((id[0] << 8) | id[1]) != ZL30733_ID_VALUE) {
+		printf("\n%s: ZL30733 I2C read id=%02x%02x, expected 0x%04x\n",
+		       __func__, id[0], id[1], ZL30733_ID_VALUE);
+		return;
+	}
+
+	/*get link speed from dts*/
+	switch (design_info) {
+	case PTP_SYS_ED_10G:
+				ptr_cmd_tbl = &mfg_i2c_cmd_tbl_26MHZ[0];
+				total_cmd_list = ARRAY_SIZE(mfg_i2c_cmd_tbl_26MHZ);
+				break;
+	case PTP_SYS_ED_25G:
+				ptr_cmd_tbl = &mfg_i2c_cmd_tbl_39MHZ[0];
+				total_cmd_list = ARRAY_SIZE(mfg_i2c_cmd_tbl_39MHZ);
+				break;
+	default:
+				printf("\n\r Using default 39MHZ PLL configuration");
+				ptr_cmd_tbl = &mfg_i2c_cmd_tbl_39MHZ[0];
+				total_cmd_list = ARRAY_SIZE(mfg_i2c_cmd_tbl_39MHZ);
+				break;
+	}
+
+	// write the register values via i2c:
+	for (i = 0; i < total_cmd_list; i++) {
+		if (ptr_cmd_tbl->cmd == 'X') { // i2c write
+			new_page = ptr_cmd_tbl->addr >> 7;
+			if (new_page != page) {
+				page = new_page;
+				ret_val = dm_i2c_write(udev, 0x7f, &page, 1);
+				if (ret_val)
+					printf("\n%s: Page %u select failed\n",
+					       __func__, page);
+			}
+			addr = ptr_cmd_tbl->addr & 0x7f;
+			ret_val = dm_i2c_write(udev, addr,
+					       &ptr_cmd_tbl->val, 1);
+			if (ret_val)
+				printf("\n%s: i2c_write(0x%04x, 0x%02x) failed\n",
+				       __func__, ptr_cmd_tbl->addr,
+				       ptr_cmd_tbl->val);
+		} else if (ptr_cmd_tbl->cmd == 'W') { // wait (delay)
+			val = ptr_cmd_tbl->addr;
+			if (val >= 1000)
+				mdelay(1 + val / 1000);
+			else
+				udelay(val);
+		}
+		ptr_cmd_tbl++;
+	}
+	printf("\r\n...Configuring PLL Done!\n");
+}
