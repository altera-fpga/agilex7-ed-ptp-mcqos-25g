 		switch (desc->devtype) {
 		case fpga_xilinx:
@@ -272,6 +405,16 @@ int fpga_load(int devnum, const void *buf, size_t bsize, bitstream_type bstype,
 		case fpga_altera:
 #if defined(CONFIG_FPGA_ALTERA)
 			ret_val = altera_load(desc->devdesc, buf, bsize);
+
+			if (ret_val == 0) {
+				// Intel Agilex FM87 board support for 1588/PTP
+				// write ZL30733 registers via I2C:
+				// // (FPGA loaded first to have I2C access)
+				zl30733_i2c_init(get_ptp_design_info());
+				// must reload FPGA image after ZL30733 DPLL's
+				// have been changed (FPGA clocks have changed)
+				ret_val = altera_load(desc->devdesc, buf, bsize);
+			}
 #else
 			fpga_no_sup((char *)__func__, "Altera devices");
 #endif
